# RevoShop - environment variable template. Copy to .env; .env is gitignored and must never be committed.

# -------------------------------------------------------------------
# DATABASE (Supabase Postgres, two-URL setup)
# -------------------------------------------------------------------
# This project uses two connection strings, following Supabase's
# recommended split:
#
#   DATABASE_URL - app runtime. Points at the transaction-mode pooler
#                  (port 6543, IPv4). Best for many short-lived web
#                  requests. Used by `flask run` and all API traffic.
#
#   DIRECT_URL   - migrations only. Points at the session-mode pooler
#                  (port 5432). Migrations need real session-mode DDL
#                  transactions, which the transaction pooler can't do.
#                  Used by Alembic / `flask db upgrade` / `flask db migrate`.
#                  config.py falls back to DATABASE_URL if this is unset,
#                  so a plain local Postgres (single URL) still works.
#
# Get both strings from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> "Transaction"
#   (6543) for DATABASE_URL and "Session" (5432) for DIRECT_URL.
#
# IMPORTANT when copying from Supabase:
#   1. Replace [YOUR-PASSWORD] with your real database password
#      (Project Settings -> Database -> Database password; reset it there
#      if you forgot it). This is NOT your Supabase account login password.
#   2. Do NOT wrap the value in quotes. python-dotenv keeps quotes literally,
#      which corrupts the connection string.
#   3. Drop any `?pgbouncer=true` suffix. That is a Prisma-only flag;
#      SQLAlchemy / psycopg2 do not understand it and will fail to connect.
#   4. If your password contains special characters, URL-encode them, e.g.
#      @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25
#      (~ is safe and needs no encoding).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# For a plain local Postgres instead of Supabase, use a single URL and
# omit DIRECT_URL (config.py will fall back to DATABASE_URL):
#   DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_db

# Flask secret key, used for session signing. Generate your own, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret

# Enable Flask's debug mode (auto-reload, interactive debugger). Use "false" in production.
#
# This must be "false" on a deployed host. Flask ties PROPAGATE_EXCEPTIONS to
# DEBUG, so with debug on an unhandled error bypasses the JSON handlers in
# errors.py and the client gets the WSGI server's HTML error page instead —
# which a frontend calling response.json() cannot parse.
FLASK_DEBUG=true

# -------------------------------------------------------------------
# CORS (browser frontend access)
# -------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# Optional: if unset, config.py defaults to the usual local frontend dev
# servers (localhost/127.0.0.1 on ports 3000 and 5173).
#
# Set this to the deployed frontend's origin in production, e.g.
#   CORS_ORIGINS=https://my-shop.vercel.app,http://localhost:5173
#
# An explicit allowlist is used instead of "*" because a permitted origin can
# drive every endpoint a logged-in user can reach. Include the scheme and
# port, and no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------------
# JWT AUTHENTICATION
# -------------------------------------------------------------------
# All optional: the app boots with the defaults below if none are set.

# Signing key for access/refresh tokens. Kept separate from SECRET_KEY so it
# can be rotated on its own — changing it immediately invalidates every
# outstanding token, which is the emergency "log everybody out" switch.
# Falls back to SECRET_KEY when unset. Generate one the same way:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_different_random_secret

# Access token lifetime in minutes (default 15). Short on purpose: an access
# token cannot be checked for revocation without cost on every request, so a
# small window limits how long a leaked one is useful. The frontend should
# treat a 401 with "code": "token_expired" as "call POST /auth/refresh, then
# retry" rather than as a logout.
JWT_ACCESS_MINUTES=15

# Refresh token lifetime in minutes (default 10080 = 7 days).
#
# With refresh-token rotation this is effectively the session's IDLE timeout,
# and it is what produces the auto-logout: every successful POST /auth/refresh
# issues a new refresh token and revokes the one just used, so an actively
# used session keeps sliding forward, while a session left idle longer than
# this finds its refresh token expired. At that point /auth/refresh answers
# 401 with "code": "token_expired" and "token_type": "refresh", which is the
# frontend's cue to clear both tokens and show the login screen.
#
# Set this low to see the auto-logout quickly, e.g. 30 for a 30-minute idle
# window, or 2 when testing the behaviour by hand.
JWT_REFRESH_MINUTES=10080

# Value of `users.role` that unlocks the admin-only endpoints (create/update/
# delete products and categories, and changing an order's status). Compared
# case-insensitively. Default "ADMIN"; ordinary accounts get the 'CUSTOMER'
# server default.
#
# Note that POST /users refuses to honor a caller-supplied `role` unless the
# request already carries an admin token, so the first admin has to be made
# directly in the database, e.g.
#   UPDATE users SET role = 'ADMIN' WHERE email = 'you@example.com';
ADMIN_ROLE=ADMIN

# -------------------------------------------------------------------
# LOAD TESTING (Locust)
# -------------------------------------------------------------------
# Locust commits real orders and deducts real stock against whatever
# DATABASE_URL points at. It now also registers one throwaway account per
# simulated user (the order endpoints need a token) and leaves a
# token_blocklist row behind for each refresh. Run it against a
# throwaway/test database so those writes never touch data you care about.
#
# Optional: set both of these to log in as one existing account instead of
# registering throwaway ones. Note that accounts created by seed.sql cannot
# log in — it stores placeholder strings like 'hash_budi_001' in
# password_hash rather than real Werkzeug hashes — so use an account created
# through POST /users.
#   LOCUST_EMAIL=you@example.com
#   LOCUST_PASSWORD=your_password
#
# For a local Postgres load-test DB:
#   1. Create the database:
#        CREATE DATABASE revoshop_test;
#   2. Apply migrations against it (PowerShell):
#        $env:DATABASE_URL="postgresql://postgres:your_password_here@localhost/revoshop_test"; flask db upgrade
#   3. Seed users, categories, and products (omit orders/order_items).
#
# For Supabase, point at a separate Supabase project (or schema) the same
# way, then start the server against it before running Locust:
#   $env:DATABASE_URL="<your test connection string>"; flask run
#
# Then run Locust:
#   locust -f locustfile.py --host=http://127.0.0.1:5000
#
# When done, close that terminal (or unset DATABASE_URL) so .env takes
# effect again.
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_test
