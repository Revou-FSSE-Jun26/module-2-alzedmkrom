# RevoShop - environment variable template. Copy to .env; .env is gitignored and must never be committed.

# PostgreSQL connection string for your main development database (revoshop_db).
# Format: postgresql://<user>:<password>@<host>/<database>
# Used by `flask run`, `flask db upgrade`, `flask check-db`, and all Postman testing.
DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_db

# Flask secret key, used for session signing. Generate your own, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret

# Enable Flask's debug mode (auto-reload, interactive debugger). Use "false" in production.
FLASK_DEBUG=true

# -------------------------------------------------------------------
# LOAD TESTING (Locust)
# -------------------------------------------------------------------
# Run Locust against a separate database so test orders/stock changes
# never touch your main revoshop_db data.
#
# One-time setup for revoshop_test:
#   1. Create the database in pgAdmin or psql:
#        CREATE DATABASE revoshop_test;
#   2. Apply migrations:
#        $env:DATABASE_URL="postgresql://postgres:your_password_here@localhost/revoshop_test"; flask db upgrade
#   3. Seed users, categories, and products (copy from seed.sql, omit
#      the orders/order_items blocks):
#        psql -U postgres -d revoshop_test -f seed.sql   # then DELETE FROM orders; DELETE FROM order_items;
#      Or run the Python seed script if available.
#
# To start the Flask server pointing at revoshop_test (PowerShell):
#   $env:DATABASE_URL="postgresql://postgres:your_password_here@localhost/revoshop_test"; flask run
#
# Then run Locust normally:
#   locust -f locustfile.py --host=http://127.0.0.1:5000
#
# When done, switch DATABASE_URL back to revoshop_db (or restart the
# terminal so .env takes effect again).
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_test
