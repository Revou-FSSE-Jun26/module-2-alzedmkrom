# RevoShop - environment variable template. Copy to .env; .env is gitignored and must never be committed.

# -------------------------------------------------------------------
# DATABASE (Supabase Postgres, two-URL setup)
# -------------------------------------------------------------------
# This project uses two connection strings, following Supabase's
# recommended split:
#
#   DATABASE_URL - app runtime. Points at the transaction-mode pooler
#                  (port 6543, IPv4). Best for many short-lived web
#                  requests. Used by `flask run` and all API traffic.
#
#   DIRECT_URL   - migrations only. Points at the session-mode pooler
#                  (port 5432). Migrations need real session-mode DDL
#                  transactions, which the transaction pooler can't do.
#                  Used by Alembic / `flask db upgrade` / `flask db migrate`.
#                  config.py falls back to DATABASE_URL if this is unset,
#                  so a plain local Postgres (single URL) still works.
#
# Get both strings from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> "Transaction"
#   (6543) for DATABASE_URL and "Session" (5432) for DIRECT_URL.
#
# IMPORTANT when copying from Supabase:
#   1. Replace [YOUR-PASSWORD] with your real database password
#      (Project Settings -> Database -> Database password; reset it there
#      if you forgot it). This is NOT your Supabase account login password.
#   2. Do NOT wrap the value in quotes. python-dotenv keeps quotes literally,
#      which corrupts the connection string.
#   3. Drop any `?pgbouncer=true` suffix. That is a Prisma-only flag;
#      SQLAlchemy / psycopg2 do not understand it and will fail to connect.
#   4. If your password contains special characters, URL-encode them, e.g.
#      @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25
#      (~ is safe and needs no encoding).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# For a plain local Postgres instead of Supabase, use a single URL and
# omit DIRECT_URL (config.py will fall back to DATABASE_URL):
#   DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_db

# Flask secret key, used for session signing. Generate your own, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret

# Enable Flask's debug mode (auto-reload, interactive debugger). Use "false" in production.
FLASK_DEBUG=true

# -------------------------------------------------------------------
# LOAD TESTING (Locust)
# -------------------------------------------------------------------
# Locust commits real orders and deducts real stock against whatever
# DATABASE_URL points at. Run it against a throwaway/test database so
# test writes never touch data you care about.
#
# For a local Postgres load-test DB:
#   1. Create the database:
#        CREATE DATABASE revoshop_test;
#   2. Apply migrations against it (PowerShell):
#        $env:DATABASE_URL="postgresql://postgres:your_password_here@localhost/revoshop_test"; flask db upgrade
#   3. Seed users, categories, and products (omit orders/order_items).
#
# For Supabase, point at a separate Supabase project (or schema) the same
# way, then start the server against it before running Locust:
#   $env:DATABASE_URL="<your test connection string>"; flask run
#
# Then run Locust:
#   locust -f locustfile.py --host=http://127.0.0.1:5000
#
# When done, close that terminal (or unset DATABASE_URL) so .env takes
# effect again.
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost/revoshop_test
